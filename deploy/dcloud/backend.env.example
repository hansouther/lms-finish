# Salin ke backend/.env lalu isi. JANGAN commit file .env ke repository.

# ---- Database ----
MONGO_URL=mongodb://lmsadmin:GANTI-password@mongo:27017/?authSource=admin
DB_NAME=binara_lms

# ---- Admin awal (dibuat otomatis saat startup pertama) ----
ADMIN_EMAIL=admin@domain-anda.com
ADMIN_PASSWORD=GANTI-password-admin-kuat

# ---- Keamanan (buat JWT_SECRET: openssl rand -hex 32) ----
JWT_SECRET=GANTI-random-64-karakter
CORS_ORIGINS=https://domain-anda.com,https://www.domain-anda.com

# ---- Google OAuth pribadi (console.cloud.google.com -> Credentials -> OAuth Client ID Web) ----
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ---- Storage S3 / S3-compatible (AWS S3, Cloudflare R2, MinIO, Wasabi, dll) ----
# Kosongkan S3_ENDPOINT_URL untuk AWS S3 asli. Bila semua kosong -> file disimpan di disk lokal (storage_data/).
S3_ENDPOINT_URL=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ---- Email: Brevo API (utama) lalu SMTP/Gmail (cadangan) ----
BREVO_API_KEY=
EMAIL_FROM_NAME=Binara LMS
EMAIL_FROM_ADDRESS=admin@domain-anda.com
EMAIL_REPLY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Midtrans ----
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
